#!/usr/bin/env python3
"""Client: say [text...]   (reads stdin if no args)  |  say --stop"""
import os
import socket
import sys

path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "ttsd.sock")
if sys.argv[1:] == ["--stop"]:
    msg = "STOP\n"
else:
    text = " ".join(sys.argv[1:]) if len(sys.argv) > 1 else sys.stdin.read()
    msg = "SAY\n" + text

s = socket.socket(socket.AF_UNIX)
try:
    s.connect(path)
except OSError as e:
    sys.exit(f"say: cannot reach daemon at {path}: {e}")
s.sendall(msg.encode())
s.close()
